# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── SMTP verification settings ───────────────────────────────────────────────
# "From" address used in MAIL FROM during SMTP probe (never actually sends mail)
SMTP_FROM_ADDRESS=verify@example.com

# Domain sent in the EHLO/HELO handshake (must resolve to your server's IP)
SMTP_HELO_DOMAIN=example.com

# How long to wait for an initial TCP connection to the MX host (ms)
SMTP_CONNECT_TIMEOUT_MS=8000

# How long to wait for each SMTP command response (ms)
SMTP_RESPONSE_TIMEOUT_MS=10000

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Max verify requests per IP per minute
RATE_LIMIT_PER_IP_PER_MINUTE=20

# Max verify requests per domain per hour (prevents hammering one company's MX)
RATE_LIMIT_PER_DOMAIN_PER_HOUR=60

# ─── Cache ────────────────────────────────────────────────────────────────────
# How many days to cache a verification result before re-checking
CACHE_TTL_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your Chrome extension's origin — found in chrome://extensions (ID shown there)
# Format: chrome-extension://<extension-id>
# During development you can also allow http://localhost for testing
CORS_ALLOWED_ORIGIN=chrome-extension://YOUR_EXTENSION_ID_HERE
